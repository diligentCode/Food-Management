# ===================================================================
# FOODCONNECT - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env to enable optional live Cloud Firebase & Gemini AI.
# The application also features an in-app Settings modal to configure
# these directly in the browser on any device with zero command-line setup!
# ===================================================================

# Firebase Cloud Firestore & Authentication (Multi-Device Live Sync)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-foodconnect-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-foodconnect-project
VITE_FIREBASE_STORAGE_BUCKET=your-foodconnect-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Google Gemini Vision API (Multimodal AI Image Quality Check)
# Obtain a free key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere
